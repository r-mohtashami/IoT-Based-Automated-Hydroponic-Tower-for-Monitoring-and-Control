# Local Docker Compose configuration template.
# Copy this file to .env and edit the local copy only.
# Do not put real secrets in .env.example and do not commit .env.

# PostgreSQL local-development credentials.
POSTGRES_DB=hydroponics
POSTGRES_USER=hydroponics
POSTGRES_PASSWORD=hydroponics_dev

# Simulator configuration.
# Numeric baselines/jitter/deviations are synthetic simulation inputs, not agronomic targets.
SIMULATED_TOWER_COUNT=3
SIM_TELEMETRY_INTERVAL_SECONDS=5
SIM_RANDOM_SEED=42
# The Docker simulator follows Towers created/removed through the backend, so UI-created
# towers begin receiving simulated telemetry without manually changing a tower count.
SIM_TOWER_REFRESH_SECONDS=2

# Optional missing-sensor simulation.
# Format: sim-2:ppfd_umol_m2_s;sim-3:ec_ms_cm,humidity_pct
SIM_MISSING_SENSORS=

# Optional controlled deviation. Set all three together for a targeted demo episode.
SIM_DEVIATION_TOWER=
SIM_DEVIATION_FACTOR=
SIM_DEVIATION_OFFSET=

# Application freshness/timing policies. These are operational guards, not crop thresholds.
RECOMMENDATION_MAX_TELEMETRY_AGE_SECONDS=120
RECOMMENDATION_MAX_FUTURE_CLOCK_SKEW_SECONDS=5
ACTUATOR_VERIFICATION_TIMEOUT_SECONDS=5
# Monitoring debounce for recovery/reopen near a target boundary. These are not agronomic targets.
ALERT_RECOVERY_CONFIRMATION_READINGS=3
ALERT_REOPEN_CONFIRMATION_READINGS=3

# Optional local AI Assistant configuration.
# The core platform works even if Ollama is stopped. No API key or paid subscription is required.
# Docker Desktop on macOS/Windows reaches host Ollama through host.docker.internal.
# If you run the backend directly on the host instead of Docker, use http://localhost:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=120

# Used only when running Streamlit directly on the host instead of Docker Compose.
BACKEND_BASE_URL=http://localhost:8000
